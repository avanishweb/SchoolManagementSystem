# ==============================================================================
# SMART SCHOOL MANAGEMENT SYSTEM - ROOT ENVIRONMENT TEMPLATE
# Copy this file to .env before starting the development environment.
# Note: In production, supply secrets through secure secret managers or CI/CD.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend API Configuration (apps/api)
# ------------------------------------------------------------------------------
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_school_erp
CLIENT_URL=http://localhost:5173

# JWT Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_smart_school_min_32_chars_ok!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_smart_school_min_32_chars_ok!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Security (set to true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Rate Limiting (Standard API traffic - 2000 in dev, 500 in prod per 15 min window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000

# Authentication Rate Limiting (Login brute-force protection - 50 in dev, 10 in prod per 15 min window)
# Successful logins do not count against this limit (skipSuccessfulRequests: true)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=50

# ------------------------------------------------------------------------------
# Frontend Web Configuration (apps/web)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME="Smart School ERP"

# ------------------------------------------------------------------------------
# Desktop Shell Configuration (apps/desktop)
# ------------------------------------------------------------------------------
VITE_DEV_SERVER_URL=http://localhost:5173
